rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'ADMIN';
    }

    function isManager() {
      return signedIn() && (role() == 'ADMIN' || role() == 'MANAJER');
    }

    // Profil akun. Kredensial (password) dikelola Firebase Auth, bukan di sini.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'ADMIN');
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if signedIn();
      allow create, delete: if isManager();
      // Kasir hanya boleh mengubah stok (saat checkout)
      allow update: if isManager() ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // Outlet / cabang. Dibaca semua user, diubah admin.
    match /outlets/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Pengaturan bersama: shift, jam kerja, watermark, nama toko.
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      // Riwayat penjualan hanya bisa dihapus admin.
      allow update: if false;
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
